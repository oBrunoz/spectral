# copie para .env e preencha. o .env nunca vai para o git.
NODE_ENV=development
PORT=3000

# origens autorizadas a chamar a API, separadas por virgula
CORS_ORIGIN=http://localhost:4200

# connection string do Postgres (Neon, Supabase ou container local)
DATABASE_URL=postgresql://usuario:senha@host/banco?sslmode=require

# segredo que assina os tokens. minimo 32 caracteres, um por ambiente.
# gere com: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=

# chave da TMDB. a partir daqui ela vive so no servidor.
TMDB_API_KEY=
